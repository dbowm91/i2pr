{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "i2pr-java-helper-build-manifest-v1",
  "title": "Plan 063 Java direct driver build manifest",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "reference_name",
    "reference_version",
    "reference_revision",
    "reference_source_tree_sha256",
    "i2p_jar_sha256",
    "router_jar_sha256",
    "all_runtime_jar_sha256_values",
    "driver_source_sha256",
    "driver_binary_sha256",
    "classpath_manifest_sha256",
    "javac_version",
    "java_version",
    "build_command_version",
    "build_timestamp_utc"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "i2pr-java-helper-build-manifest-v1"
    },
    "schema_version": {
      "const": 1
    },
    "reference_name": {
      "type": "string",
      "enum": ["java_i2p"]
    },
    "reference_version": {
      "type": "string",
      "const": "2.12.0"
    },
    "reference_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "const": "2800040deee9bb376567b671ef2e9c34cf3e30b6"
    },
    "reference_source_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference_archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "i2p_jar_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "router_jar_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "all_runtime_jar_sha256_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "driver_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "driver_binary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "classpath_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "javac_version": {
      "type": "string",
      "minLength": 1
    },
    "java_version": {
      "type": "string",
      "minLength": 1
    },
    "ant_version": {
      "type": "string"
    },
    "build_command_version": {
      "type": "string",
      "minLength": 1
    },
    "build_timestamp_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "native_libraries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jbigi_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "jcpuid_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
