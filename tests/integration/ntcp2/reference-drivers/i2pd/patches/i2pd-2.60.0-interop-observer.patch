+			}
+			std::strncpy (observer_md.transport, "ntcp2", sizeof (observer_md.transport) - 1);
+			observer_md.monotonic_ms = static_cast<std::uint64_t> (
+				std::chrono::duration_cast<std::chrono::milliseconds> (
+					std::chrono::steady_clock::now().time_since_epoch ())
+					.count ());
+			i2pr::i2pdinterop::ObserveAuthenticated (observer_md);
+		}
